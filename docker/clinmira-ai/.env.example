# ClinMira AI isolated local dev/test stack.
# Copy to docker/clinmira-ai/.env for local use if you want to override defaults.
# Do not use production, staging, real patient data, or real secrets here.

CLINMIRA_DOCKER_POSTGRES_DB=clinmira_ai_docker_dev
CLINMIRA_DOCKER_POSTGRES_USER=clinmira_ai_docker_user
CLINMIRA_DOCKER_POSTGRES_PASSWORD=<strong-local-only-password>
CLINMIRA_DOCKER_POSTGRES_HOST_PORT=55433
CLINMIRA_DOCKER_API_PORT=41731
CLINMIRA_DOCKER_FRONTEND_PORT=41730

CLINMIRA_DOCKER_DATABASE_URL=postgresql://clinmira_ai_docker_user:<strong-local-only-password>@postgres:5432/clinmira_ai_docker_dev
CLINMIRA_DOCKER_HOST_DATABASE_URL=postgresql://clinmira_ai_docker_user:<strong-local-only-password>@127.0.0.1:55433/clinmira_ai_docker_dev
