FROM node:22-bookworm-slim AS deps

WORKDIR /app

COPY shared/contracts ./shared/contracts
COPY backend/api/package.json backend/api/package-lock.json ./backend/api/

RUN cd backend/api && npm ci --ignore-scripts
RUN cd shared/contracts && ../../backend/api/node_modules/.bin/tsc -p tsconfig.json

FROM deps AS build

WORKDIR /app

COPY backend/api ./backend/api

RUN cd backend/api && npm run build

FROM node:22-bookworm-slim AS runner

ENV NODE_ENV=production
ENV API_PORT=3001
ENV CLINMIRA_LIVE_AGENTS_ENABLED=false
ENV CLINMIRA_OPENAI_PROVIDER_ENABLED=false
ENV CLINMIRA_LIVE_PROVIDER_KILL_SWITCH=true

WORKDIR /app

COPY --from=build /app/shared/contracts ./shared/contracts
COPY --from=build /app/backend/api ./backend/api

EXPOSE 3001

CMD ["node", "backend/api/dist/backend/api/src/main.js"]
