{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinmira.ai/contracts/replay-request.v1.schema.json",
  "title": "ReplayRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "after_sequence",
    "limit",
    "audience"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "replay-request.v1" },
    "session_id": { "type": "string", "format": "uuid" },
    "stream_type": { "type": "string", "const": "simulation_session" },
    "after_sequence": { "type": "integer", "minimum": 0 },
    "limit": { "type": "integer", "minimum": 1, "maximum": 500, "default": 100 },
    "audience": {
      "type": "string",
      "enum": [
        "student",
        "faculty",
        "system"
      ]
    },
    "include_non_replayable": { "type": "boolean", "default": false }
  }
}
